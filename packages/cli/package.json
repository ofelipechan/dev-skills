{
  "name": "@ofelipechan/dev-skills",
  "version": "0.1.0",
  "description": "Install reusable Agent Skills into Claude Code, OpenAI Codex and future agents.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ofelipechan/dev-skills.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "bin": {
    "dev-skills": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "node ../../scripts/prepare-package.mjs && npm run build"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "commander": "14.0.3",
    "gray-matter": "4.0.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "agent-skills",
    "claude-code",
    "codex",
    "skills",
    "cli"
  ],
  "homepage": "https://github.com/ofelipechan/dev-skills#readme",
  "bugs": {
    "url": "https://github.com/ofelipechan/dev-skills/issues"
  }
}
